export class Locale {
  private static cached: boolean | undefined = undefined;
  /**
   * 用户在「设置 → 语言」里的选择：'system' | 'zh' | 'en'
   * 默认跟随系统，和没加这个设置之前的行为一致。
   */
  private static override: string = 'system';

  /** 设置页切换语言时调用；启动时也要按已保存的偏好注入一次 */
  static setOverride(value: string): void {
    Locale.override = value;
    // 清掉缓存，下次 t() 重新判定
    Locale.cached = undefined;
  }

  static getOverride(): string {
    return Locale.override;
  }

  /** 当前是否中文环境 */
  static isZh(): boolean {
    if (Locale.cached === undefined) {
      let zh: boolean = true;
      if (Locale.override === 'zh') {
        zh = true;
      } else if (Locale.override === 'en') {
        zh = false;
      } else {
        try {
          const lang: string = i18n.System.getSystemLanguage();
          zh = lang.toLowerCase().startsWith('zh');
        } catch (e) {
          zh = true;
        }
      }
      Locale.cached = zh;
    }
    return Locale.cached as boolean;
  }

  /** 当前语言标记，写入日志/上报用 */
  static tag(): string {
    return Locale.isZh() ? 'zh' : 'en';
  }

  /**
   * 系统地名解析（逆地理编码）要用的语言标签。
   *
   * 只传纯语言码：实测传 'en-US' 时系统照旧返回中文地名「东营市」，
   * 传 'en' 才返回 'Dongying'。中文侧 'zh' / 'zh-CN' 都正常，
   * 所以只有英文这一侧必须避开带地区的写法。
   */
  static geocodeLocale(): string {
    return Locale.isZh() ? 'zh' : 'en';
  }
}

/**
 * 取文案
 * @param key 词典 key
 * @param args 占位符参数，依次替换 {0} {1} …
 */
export function t(key: string, args: (string | number)[] = []): string {
  const dict: Map<string, string> = Locale.isZh() ? ZH : EN;
  // ArkTS 不支持 in 运算符，用 Map.get 取不到即为缺 key
  const raw: string | undefined = dict.get(key);
  if (raw === undefined) {
    return key;
  }
  let s: string = raw;
  for (let i = 0; i < args.length; i++) {
    s = s.replace(`{${i}}`, `${args[i]}`);
  }
  return s;
}
