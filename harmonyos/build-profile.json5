{
  "app": {
    // 开源版不含签名配置（证书 / 口令属于开发者私有材料，绝不入库）。
    // 本地打包前请在 app 下补回 signingConfigs，并在 products 里加
    //   "signingConfig": "default"
    // 形如：
    //   "signingConfigs": [{ "name": "default", "type": "HarmonyOS",
    //     "material": { "certpath": "./signature/xxx.cer",
    //                   "storePassword": "< DevEco 生成的加密串 >",
    //                   "keyAlias": "...", "keyPassword": "...",
    //                   "profile": "./signature/xxx.p7b",
    //                   "signAlg": "SHA256withECDSA",
    //                   "storeFile": "./signature/xxx.p12" } }]
    "products": [
      {
        "name": "default",
        // 最低兼容 API 18（HarmonyOS 5.1）。1.1.1 起不再发布手表端，
        // 保留 18 是为了覆盖仍在使用 HarmonyOS 5.1 的老手机。
        // 代价：超过 18 的 API 都要用 canIUse 判断（本项目已对定位、代理提醒做了保护）。
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "5.1.0(18)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
