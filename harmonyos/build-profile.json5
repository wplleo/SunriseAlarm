{
  "app": {
    // 开源版不含签名配置（证书 / 口令属于开发者私有材料，绝不入库）。
    // 本地打包前请在 app 下补回 signingConfigs，并在 products 里加
    //   "signingConfig": "default"
    // 形如：
    //   "signingConfigs": [{ "name": "default", "type": "HarmonyOS",
    //     "material": { "certpath": "./signature/xxx.cer",
    //                   "storePassword": "< DevEco 生成的加密串 >",
    //                   "keyAlias": "...", "keyPassword": "...",
    //                   "profile": "./signature/xxx.p7b",
    //                   "signAlg": "SHA256withECDSA",
    //                   "storeFile": "./signature/xxx.p12" } }]
    "products": [
      {
        "name": "default",
        // 编译仍用 API 26 SDK（能写最新 API），但最低兼容到 API 18。
        // 原因：手表（WATCH 5 等智能穿戴）首次支持是 HarmonyOS 5.1 / API 18，
        // 之前写 26.0.0 会导致手表根本装不上这个包。
        // 代价：手机端也能装到 API 18-25 的老设备，所以超过 18 的 API
        //      都要用 canIUse 判断（本项目已对定位、代理提醒做了保护）。
        "compileSdkVersion": "26.0.0",
        "compatibleSdkVersion": "5.1.0(18)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "wearable",
      "srcPath": "./wearable",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
